{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/rathika/browser",
      "url": [
        "http://localhost/index.html",
        "http://localhost/products/index.html",
        "http://localhost/about/index.html"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "skipAudits": ["uses-http2"],
        "chromeFlags": "--no-sandbox --disable-gpu --disable-dev-shm-usage --disable-setuid-sandbox --disable-software-rasterizer --no-first-run"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance":     ["warn",  { "minScore": 0.85 }],
        "categories:accessibility":   ["error", { "minScore": 0.95 }],
        "categories:best-practices":  ["error", { "minScore": 0.90 }],
        "categories:seo":             ["error", { "minScore": 1.00 }],
        "cumulative-layout-shift":    ["error", { "maxNumericValue": 0.10 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}

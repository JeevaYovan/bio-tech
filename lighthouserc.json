{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/rathika/browser",
      "url": [
        "http://localhost/index.html",
        "http://localhost/products/index.html",
        "http://localhost/products/tea-cup-100ml/index.html",
        "http://localhost/products/straw-8in/index.html",
        "http://localhost/about/index.html",
        "http://localhost/contact/index.html",
        "http://localhost/privacy/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance":     ["error", { "minScore": 0.95 }],
        "categories:accessibility":   ["error", { "minScore": 0.95 }],
        "categories:best-practices":  ["error", { "minScore": 0.95 }],
        "categories:seo":             ["error", { "minScore": 1.00 }],
        "cumulative-layout-shift":    ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time":        ["warn",  { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}

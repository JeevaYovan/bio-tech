{
  "name": "rathika",
  "version": "0.1.0",
  "private": true,
  "description": "Rathika Biotech Products — biodegradable tableware from Coimbatore. Static marketing + product catalog site.",
  "homepage": "https://rathika.in",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "postbuild": "node scripts/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:static": "npx --yes serve dist/rathika/browser -l 4200",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "lhci": "lhci autorun"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.9",
    "@klaro/theme": "^0.3.4",
    "@klaro/ui": "^0.6.0",
    "@klaro/utils": "^0.3.2",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
